# Cloudflare static-asset headers (https://developers.cloudflare.com/workers/static-assets/headers/)
# The strict connect-src is the privacy guarantee: the page has no third-party
# egress except Google's Gemini endpoint, so a BYO key can't be sent elsewhere.
# (A matching <meta> CSP in index.html covers non-Cloudflare hosts; frame-ancestors
# can only be delivered as a header, so it lives here.)
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://generativelanguage.googleapis.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin

# Vite content-hashed filenames are immutable, so cache them hard. index.html is
# not under /assets/, so it keeps Cloudflare's default revalidate-always and
# deploys take effect immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

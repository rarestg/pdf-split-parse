{
  // Cloudflare Workers Static Assets (assets-only — this app has no backend).
  // Deploy a production build with: npm run deploy
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdf-split-parse",
  "compatibility_date": "2026-06-30",
  // Serve the Vite build straight from the edge. There is no `main` worker: the
  // browser talks directly to Google's Gemini endpoint, so a worker would have
  // nothing to do. The CSP egress lock in `public/_headers` is honored by Workers
  // Static Assets and applied to these static responses.
  "assets": {
    "directory": "./dist"
    // not_found_handling omitted (defaults to "none"): there is no client-side
    // router, and `base: './'` means an SPA fallback would break relative asset
    // URLs on deep paths. Unknown paths return a plain 404.
  },
  // Bind the apex directly. Because the zone is in this same Cloudflare account,
  // `wrangler deploy` provisions the Custom Domain and its proxied DNS record.
  "routes": [{ "pattern": "pdfsplitparse.com", "custom_domain": true }],
  "workers_dev": false, // Disable the public production *.workers.dev URL; custom domain only.
  "preview_urls": true // Keep preview URLs for PR/branch builds (Cloudflare Workers Builds).
}

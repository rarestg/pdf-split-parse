{
  "name": "pdf-split-parse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super-parallel client-side PDF → Markdown OCR using your own Google Gemini API key: split a PDF and OCR every page at once (up to 128 in parallel). No backend; your key and documents never leave the browser.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wrangler": "^4.93.0"
  }
}

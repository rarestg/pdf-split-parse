{
  "name": "pdf-split-parse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Super-parallel client-side PDF → Markdown OCR using your own Google Gemini API key: split a PDF and OCR every page at once (up to 128 in parallel). No backend; your key and documents never leave the browser.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test tests/*.test.ts",
    "smoke": "tsx scripts/smoke.ts",
    "assets:og": "tsx scripts/og-assets.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.93.0"
  }
}
